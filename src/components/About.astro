---
import { siteContent } from "../content/siteContent";
---

<section class="about section" id="about" aria-labelledby="about-title">
  <div class="site-shell about__grid">
    <div class="about__heading" data-reveal>
      <p class="section-eyebrow">{siteContent.about.eyebrow}</p>
      <h2 class="section-title section-title--large" id="about-title">
        {siteContent.about.titleLines.map((line) => (
          <span class="section-title__line title-line">{line}</span>
        ))}
      </h2>
    </div>
    <div class="about__copy" data-reveal>
      {siteContent.about.paragraphs.map((paragraph) => (
        <p class="about__paragraph">{paragraph}</p>
      ))}
      <div class="about__meaning" aria-label="コージュの名前に込めた意味">
        <span class="about__meaning-word">CO</span>
        <span class="about__meaning-text">CO-EXIST</span>
        <span class="about__meaning-divider"></span>
        <span class="about__meaning-word">JU</span>
        <span class="about__meaning-text">JOIN US</span>
      </div>
    </div>
  </div>
</section>
